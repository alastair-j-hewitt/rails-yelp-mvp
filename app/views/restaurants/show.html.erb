<h1><%= @restaurant.name %></h1>
<p><%= @restaurant.address %></p>
<p>Category: <%= @restaurant.category %></p>
<% if @restaurant.phone_number.present? %>
  <p>Phone: <%= @restaurant.phone_number %></p>
<% end %>

<h2>Reviews</h2>
<% if @restaurant.reviews.any? %>
  <ul>
    <% @restaurant.reviews.each do |review| %>
      <li><%= review.rating %>/5: <%= review.content %></li>
    <% end %>
  </ul>
<% else %>
  <p>No reviews yet.</p>
<% end %>

<%= link_to "Add a review", new_restaurant_review_path(@restaurant) %> |
<%= link_to "All restaurants", restaurants_path %>
